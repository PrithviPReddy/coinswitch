generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id   @default(uuid())
  sub         String      @default("")
  username    String
  password    String?
  solWallets  SolWallet[]
  SolWalletId String?
  inrWalletId String?
  inrWallet   InrWallet?
  provider    Provider
  swaps       Swap[]
  transfers   Transfer[]
}

model InrWallet {
  id          String      @id   @default(uuid())
  balance     Int
  userId      String      @unique
  user        User        @relation(fields: [userId],references: [id])
}

// An account holds as many devnet wallets as it likes. Every one of them is
// custodial in exactly the same way the first one was: the key is generated
// server side and stored here, which is what lets the server sign without a
// browser wallet. Nothing is ever imported, so a key in this table is always
// one this project generated.
model SolWallet {
  id          String    @id   @default(uuid())
  label       String
  publicKey   String
  privateKey  String
  userId      String
  user        User      @relation(fields :[userId],references: [id])
  swaps       Swap[]
  transfers   Transfer[]
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

// One row per swap attempt. Quoted comes from the mainnet Jupiter quote;
// settled is read back from devnet account state after the transaction
// confirms, so the two columns are independently sourced.
model Swap {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])

  // Nullable only because rows written before wallets could multiply predate
  // the column. Everything settled since records the wallet it moved.
  walletId       String?
  wallet         SolWallet? @relation(fields: [walletId], references: [id])

  inputSymbol    String
  outputSymbol   String

  inAmount       Decimal    @db.Decimal(30, 12)
  quotedOut      Decimal    @db.Decimal(30, 12)
  settledOut     Decimal?   @db.Decimal(30, 12)

  priceImpactPct Decimal?   @db.Decimal(12, 8)
  slippageBps    Int
  routeLabels    String[]   @default([])

  signature      String?
  status         SwapStatus @default(Pending)
  failureReason  String?

  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
}

// An outbound transfer to an arbitrary devnet address. Unlike a swap there is
// nothing to quote and no counterparty leg: value leaves the wallet and does
// not come back, so the row records where it went rather than what it fetched.
model Transfer {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])

  walletId      String
  wallet        SolWallet      @relation(fields: [walletId], references: [id])

  recipient     String
  symbol        String
  amount        Decimal        @db.Decimal(30, 12)

  signature     String?
  status        TransferStatus @default(Pending)
  failureReason String?

  createdAt     DateTime       @default(now())

  @@index([walletId, createdAt])
}

enum TransferStatus {
  Pending
  Sent
  Failed
}

enum SwapStatus {
  Pending
  Settled
  Failed
}

enum Provider {
  Google
  Demo
}
