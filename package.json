{
  "name": "coinswitch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup:devnet": "node scripts/setup-devnet.mjs",
    "sampler": "node scripts/sampler/index.mjs",
    "sampler:once": "node scripts/sampler/index.mjs --once",
    "sampler:pause": "docker compose stop sampler",
    "sampler:resume": "docker compose start sampler",
    "sampler:logs": "docker compose logs -f --tail 50 sampler",
    "export:samples": "node scripts/export-samples.mjs",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "build:fill-model": "vite-node scripts/build-fill-model.ts",
    "validate:model": "vite-node scripts/validate-model.ts",
    "fit:example-model": "vite-node scripts/cost-model-reference-fit.ts",
    "build:notebook": "node scripts/build-notebook.mjs",
    "backtest": "vite-node scripts/backtest.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@project-serum/anchor": "^0.26.0",
    "@solana/buffer-layout-utils": "^0.3.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.13.2",
    "bs58": "^6.0.0",
    "cross-fetch": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "prisma": "^6.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-node": "3.2.4",
    "vitest": "^3.2.4"
  }
