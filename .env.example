# Copy to .env, then run `npm run setup:devnet` and paste in the Solana
# values it prints (five DEVNET_*_MINT lines and VAULT_SECRET_KEY).

DATABASE_URL=postgresql://dev:devpassword@localhost:5432/coinswitch

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Optional. Quotes work without a key at a lower rate limit.
JUP_API_KEY=

MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
DEVNET_RPC_URL=https://api.devnet.solana.com

# Printed by `npm run setup:devnet`.
DEVNET_USDC_MINT=
DEVNET_USDT_MINT=
DEVNET_JUP_MINT=
DEVNET_BONK_MINT=
DEVNET_WIF_MINT=

# USD value of each project token one "Fund from vault" mints.
FUND_TOKEN_USD=250000

# simulated (default): the vault pays the quote moved by a draw from recorded
# mainnet quote drift, from models/fill-model.json (npm run build:fill-model).
# exact: the vault pays the quote. A missing model falls back to exact, loudly.
FILL_MODE=simulated
VAULT_SECRET_KEY=

DEMO_USERNAME=demo@coinswitch.local
DEMO_PASSWORD=review2

# Wallets an account may create. Each one can be funded from the vault, so
# this is really a cap on how fast the vault drains.
MAX_WALLETS_PER_USER=5

# Optional. Leave blank to use the demo login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
